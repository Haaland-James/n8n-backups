      "id": "ad63e07b-2a82-4702-bc9d-b2916311627d",
      "name": "Extract Article List",
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [
        720,
        352
      ],
      "notes": "Selectors are best-guess — verify against live page source and correct before production use (see Setup Notes)."
    },
    {
      "parameters": {
        "jsCode": "// Dedupe article list by normalized title (this blog republishes near-identical\n// essays under new slugs/dates), keep only the most recent per title, then\n// filter out anything already present in the processed-log sheet.\n\nconst extracted = items[0].json;\nconst titles = extracted.title || [];\nconst urls = extracted.url || [];\nconst dates = extracted.date || [];\n\nconst raw = titles.map((t, i) => ({\n  title: (t || '').trim(),\n  url: (urls[i] || '').startsWith('http')\n    ? urls[i]\n    : `https://app.gofunditnow.dev${urls[i] || ''}`,\n  slug: (urls[i] || '').split('/').filter(Boolean).pop() || '',\n  date: (dates[i] || '').trim()\n}));\n\n// Keep most recent slug per normalized title\nconst byTitle = new Map();\nfor (const article of raw) {\n  const key = article.title.toLowerCase().replace(/\\s+/g, ' ').trim();\n  if (!key || !article.slug) continue;\n  const existing = byTitle.get(key);\n  if (!existing || new Date(article.date) > new Date(existing.date)) {\n    byTitle.set(key, article);\n  }\n}\nconst deduped = Array.from(byTitle.values());\n\n// Filter out slugs already logged as processed\nconst logRows = $node['Read Processed Log'].json ? $items('Read Processed Log') : [];\nconst processedSlugs = new Set(\n  logRows.map(r => (r.json.slug || '').trim()).filter(Boolean)\n);\n\nconst newArticles = deduped.filter(a => !processedSlugs.has(a.slug));\n\nreturn newArticles.map(a => ({ json: a }));"
      },
