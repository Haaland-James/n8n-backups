    {
      "id": "19172d10-bbf8-40a2-bbc5-34e9c2537d6d",
      "name": "R04 — Apply Review Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "jsCode": "// R04 — Apply Review Decision\n// Only a human review action can produce APPROVED. REQUEST_REVISION never triggers regeneration in v1.\nconst v = $('R02 — Validate Review Action').first().json.review;\nconst rows = $input.all().map((x) => x.json).filter((x) => x && x.generation_key);\nconst row = rows.find((x) => Number(x.version) === v.version);\nconst maxVersion = rows.reduce((a, x) => Math.max(a, Number(x.version) || 0), 0);\nconst now = new Date().toISOString();\nconst REVIEWABLE = ['REVIEW_REQUIRED', 'APPROVED', 'REJECTED', 'REVISION_REQUESTED'];\nconst MAP = { APPROVE: 'APPROVED', REJECT: 'REJECTED', REQUEST_REVISION: 'REVISION_REQUESTED' };\n\nif (!row) return [{ json: { allowed: false, http_status: 404, body: { result: 'ERROR', error_status: 'NOT_FOUND', message: `No production record for ${v.shot_id} version ${v.version}.` } } }];\nif (!REVIEWABLE.includes(row.approval_status) || !row.output_url) {\n  return [{ json: { allowed: false, http_status: 409, body: { result: 'ERROR', error_status: 'NOT_REVIEWABLE',\n    message: `${row.generation_key} is ${row.approval_status}/${row.generation_status}; only generated clips (REVIEW_REQUIRED) can be reviewed.` } } }];\n}\nlet history = [];\ntry { history = JSON.parse(row.review_history || '[]'); } catch (e) { history = []; }\nconst newState = MAP[v.review_action];\nhistory.push({ at: now, action: v.review_action, from: row.approval_status, to: newState, notes: v.notes, reviewer: v.reviewer });\n\nconst body = {\n  result: 'REVIEW_RECORDED', shot_id: row.shot_id, version: Number(row.version), generation_key: row.generation_key,\n  previous_status: row.approval_status, approval_status: newState, notes: v.notes, output_url: row.output_url, reviewed_at: now,\n  regeneration_triggered: false,\n};\nif (v.review_action === 'REQUEST_REVISION') {\n  body.chatgpt_revision_brief = {\n    instruction: 'Produce a revised shot manifest. Keep shot_id unchanged, set version to next_version, keep generation_authorized false until the human authorizes, and apply the review notes to the prompt fields only where needed.',\n    shot_id: row.shot_id, previous_version: Number(row.version), next_version: maxVersion + 1,\n    review_notes: v.notes, previous_prompt: row.submitted_prompt, previous_manifest: (() => { try { return JSON.parse(row.manifest_json); } catch (e) { return null; } })(),\n  };\n}\nreturn [{ json: { allowed: true, http_status: 200, update: { generation_key: row.generation_key, approval_status: newState, review_notes: v.notes, reviewed_at: now, review_history: JSON.stringify(history).slice(0, 20000) }, body } }];\n"
      }
    },
