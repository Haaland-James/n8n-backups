    {
      "id": "971d9e34-f068-4d90-9e9a-3cdb5daae878",
      "name": "S03 — Format Shot Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        560
      ],
      "parameters": {
        "jsCode": "// S03 — Format Shot Status\nconst q = $('S01 — Shot Status Lookup').first().json.query || {};\nconst version = q.version ? Number(q.version) : null;\nconst rows = $input.all().map((x) => x.json).filter((x) => x && x.generation_key)\n  .filter((x) => version === null || Number(x.version) === version)\n  .sort((a, b) => Number(a.version) - Number(b.version));\nconst slim = rows.map((x) => ({\n  shot_id: x.shot_id, version: Number(x.version), generation_type: x.generation_type, generation_status: x.generation_status,\n  approval_status: x.approval_status, ltx_job_id: x.ltx_job_id || null, ltx_model: x.ltx_model, ltx_resolution: x.ltx_resolution,\n  duration_seconds: x.duration_seconds, estimated_cost_usd: x.estimated_cost_usd, submitted_at: x.submitted_at || null,\n  completed_at: x.completed_at || null, output_url: x.output_url || null, error_status: x.error_status || null,\n  error_detail: x.error_detail || null, review_notes: x.review_notes || null, reviewed_at: x.reviewed_at || null,\n}));\nreturn [{ json: { http_status: q.shot_id ? 200 : 400, body: q.shot_id ? { shot_id: q.shot_id, versions: slim, count: slim.length } : { result: 'ERROR', message: 'Pass ?shot_id=SUM-S01-E01-SC01-SH001 (optional &version=N).' } } }];\n"
      }
    },
