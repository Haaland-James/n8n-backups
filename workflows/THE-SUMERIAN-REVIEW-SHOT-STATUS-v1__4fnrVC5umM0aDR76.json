    {
      "id": "2dc53186-4843-4e2d-9085-0855e5f61c07",
      "name": "R02 — Validate Review Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        100
      ],
      "parameters": {
        "jsCode": "// R02 — Validate Review Action\nconst i = $input.first().json;\nconst src = i.body !== undefined ? (typeof i.body === 'string' ? (() => { try { return JSON.parse(i.body); } catch (e) { return { __bad: e.message }; } })() : i.body) : i;\nconst form = i['Shot ID'] !== undefined;\nconst r = form ? { shot_id: i['Shot ID'], version: Number(i['Version']), review_action: i['Review Action'], notes: i['Notes'] || '', reviewer: i['Reviewer'] || '' } : src;\nconst errors = [];\nif (r.__bad) errors.push({ field: '$body', message: 'Body is not valid JSON: ' + r.__bad });\nconst SHOT_RE = /^([A-Z0-9]{2,10})-(S\\d{2})-([A-Z0-9]{2,10})-(SC\\d{2,3})-(SH\\d{3,4})$/;\nif (!r.__bad) {\n  if (typeof r.shot_id !== 'string' || !SHOT_RE.test(r.shot_id.trim())) errors.push({ field: 'shot_id', message: 'shot_id must look like SUM-S01-E01-SC01-SH001.' });\n  if (!(Number.isInteger(r.version) && r.version >= 1)) errors.push({ field: 'version', message: 'version must be a positive integer.' });\n  if (!['APPROVE', 'REJECT', 'REQUEST_REVISION'].includes(r.review_action)) errors.push({ field: 'review_action', message: 'review_action must be APPROVE, REJECT or REQUEST_REVISION.' });\n  if (r.review_action === 'REQUEST_REVISION' && !(typeof r.notes === 'string' && r.notes.trim())) errors.push({ field: 'notes', message: 'REQUEST_REVISION requires notes describing what to change.' });\n}\nconst shot_id = typeof r.shot_id === 'string' ? r.shot_id.trim() : null;\nreturn [{ json: { valid: errors.length === 0, errors, http_status: 400, source: form ? 'form' : 'webhook',\n  review: { shot_id, version: r.version, review_action: r.review_action, notes: typeof r.notes === 'string' ? r.notes.trim() : '', reviewer: r.reviewer || '' } } }];\n"
      }
    },
