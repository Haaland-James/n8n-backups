    {
      "parameters": {
        "jsCode": "const slots = $input.all()[0].json.available_slots || [];\n\nif (slots.length === 0) {\n  return { \n    speech_response: \"I'm sorry, I don't see any openings for that specific date. Would you like to try another day?\" \n  };\n}\n\n// Format times for natural speech\nconst timeList = slots.slice(0, 4).map(slot => {\n  const [hh, mm] = slot.start_time.split(':');\n  const hour = parseInt(hh);\n  const ampm = hour >= 12 ? 'PM' : 'AM';\n  const displayHour = hour % 12 || 12;\n  return `${displayHour}:${mm} ${ampm}`;\n}).join(\", \");\n\nreturn {\n  speech_response: `I have a few openings then, including ${timeList}. Do any of those work for you?`,\n  slots: slots\n};"
      },
