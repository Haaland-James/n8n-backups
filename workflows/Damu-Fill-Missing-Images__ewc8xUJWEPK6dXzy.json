    },
    {
      "id": "prep",
      "name": "Prepare Sheet Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        80
      ],
      "parameters": {
        "jsCode": "const out = [];\n\nfor (const item of $input.all()) {\n  const j = item.json ?? {};\n  if (!j.postId) continue;\n  if (!j.imageUrl) continue;   // nothing made, leave the cell blank for next time\n\n  out.push({ json: {\n    Post_ID: j.postId,\n    Image_URL: j.imageUrl,\n    Image_Source: j.imageSource ?? '',\n  } });\n}\n\nconsole.log(out.map(o => `${o.json.Post_ID}: ${o.json.Image_Source}`).join('\\n'));\nreturn out;"
      },
      "onError": "continueRegularOutput"
    },
