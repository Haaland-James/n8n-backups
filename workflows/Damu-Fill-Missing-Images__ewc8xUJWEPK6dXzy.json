    {
      "id": "findblank",
      "name": "Find Rows Missing An Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        80
      ],
      "parameters": {
        "jsCode": "// Only bother with posts that still need to go out.\nconst MAX_PER_RUN = 15;\n\nconst norm  = (v) => String(v ?? '').trim();\nconst lower = (v) => norm(v).toLowerCase();\n\nconst out = [];\nconst skipped = [];\n\nfor (const item of $input.all()) {\n  const r = item.json;\n  const postId = norm(r.Post_ID);\n  const text   = norm(r.Post_Text);\n\n  if (!postId || !text) continue;\n  if (norm(r.Image_URL))        { continue; }               // already has one\n  if (norm(r.Buffer_post_id))   { skipped.push(`${postId}: already in Buffer`); continue; }\n  if (['skip', 'archived'].includes(lower(r.Status))) { skipped.push(`${postId}: status ${lower(r.Status)}`); continue; }\n\n  out.push({ json: {\n    postId,\n    postText: text,\n    hashtags: norm(r.Hashtags),\n    storyTopic: norm(r.Story_Topic),\n    vertical: norm(r.Vertical),\n    sourceLink: norm(r.Source_Link),\n    imageUrl: '',\n  } });\n}\n\nconsole.log(`${out.length} row(s) need an image.`);\nif (skipped.length) console.log('Skipped:\\n  ' + skipped.join('\\n  '));\n\nreturn out.slice(0, MAX_PER_RUN);"
      },
      "notes": "Blank Image_URL, not already in Buffer. Ignores approval - an image can be made before Damu approves the text.",
      "onError": "stopWorkflow"
    },
    {
