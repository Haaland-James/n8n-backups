        "jsCode": "// Merge AI-drafted reply with the original reply/lead info for downstream sheet write and email.\n\nconst aiOutput = $input.first().json.output || $input.first().json;\nlet parsed = aiOutput;\nif (typeof parsed === 'string') {\n  try { parsed = JSON.parse(parsed.replace(/```json|```/g, '').trim()); }\n  catch { parsed = { suggested_reply: '(AI draft failed)', reply_sentiment: 'neutral' }; }\n}\n\nconst reply = $('Parse Reply').item.json;\nconst lead = $('Lookup Lead (Reply)').item.json;\n\nreturn [{\n  json: {\n    provider_id: reply.provider_id,\n    name: lead.name || '(unknown)',\n    headline: lead.headline || '',\n    slice: lead.slice || '',\n    location: lead.location || '',\n    reply_text: reply.reply_text,\n    replied_at: reply.replied_at,\n    suggested_reply: (parsed.suggested_reply || '').slice(0, 400),\n    reply_sentiment: parsed.reply_sentiment || 'neutral',\n    linkedin_url: lead.public_identifier ? `https://linkedin.com/in/${lead.public_identifier}` : ''\n  }\n}];\n"
      },
