      "parameters": {
        "jsCode": "// Unipile new_relation webhook payload extraction.\n// Payload shape (from Unipile docs):\n// { account_id, user_provider_id, name, headline, ... }\n\nconst payload = $input.first().json.body || $input.first().json;\n\nreturn [{\n  json: {\n    provider_id: payload.user_provider_id || payload.provider_id,\n    name: payload.name || '',\n    first_name: (payload.name || '').split(' ')[0],\n    connected_at: new Date().toISOString(),\n    event_type: 'new_relation'\n  }\n}];\n"
      },
