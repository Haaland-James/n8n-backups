    {
      "parameters": {
        "jsCode": "// Unipile message_received webhook payload extraction.\n// Payload contains sender info and message text.\n\nconst payload = $input.first().json.body || $input.first().json;\n\n// Skip our own messages (sent by us, not incoming)\nif (payload.sender_id === payload.account_id) {\n  return [];\n}\n\nreturn [{\n  json: {\n    provider_id: payload.sender_id || payload.provider_id,\n    reply_text: payload.text || payload.message || '',\n    replied_at: new Date().toISOString(),\n    event_type: 'message_received'\n  }\n}];\n"
      },
      "id": "5d63f8c2-c405-4ab9-a6b6-2c6c52bba141",
      "name": "Parse Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1008,
        672
      ]
    },
