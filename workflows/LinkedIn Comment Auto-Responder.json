    {
      "id": "extract-id",
      "name": "Extract Post ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        16,
        288
      ],
      "parameters": {
        "jsCode": "// Extract post URN from LinkedIn URL\nconst postUrl = $input.item.json.postUrl || '';\n\nlet postId = '';\nlet postUrn = '';\n\nif (postUrl.includes('activity-')) {\n  const match = postUrl.match(/activity-(\\d+)/);\n  if (match) {\n    postId = match[1];\n    postUrn = `urn:li:activity:${postId}`;\n  }\n} else if (postUrl.includes('urn:li:activity:')) {\n  const match = postUrl.match(/urn:li:activity:(\\d+)/);\n  if (match) {\n    postId = match[1];\n    postUrn = `urn:li:activity:${postId}`;\n  }\n}\n\nif (!postId) {\n  throw new Error('Could not extract post ID from URL');\n}\n\nreturn {\n  json: {\n    postUrl: postUrl,\n    postId: postId,\n    postUrn: postUrn\n  }\n};"
      }
    },
