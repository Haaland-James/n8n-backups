    {
      "id": "prepare-reply",
      "name": "Prepare Reply Data",
      "notes": "Formats data for API - uses your exact message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        304
      ],
      "parameters": {
        "jsCode": "// Get all data from previous nodes\nconst comment = $input.item.json;\nconst userMessage = comment.replyMessage;\nconst postUrn = $('Extract Post ID').item.json.postUrn;\n\n// Handle author field - it can be string or object\nlet authorName = 'Unknown';\nif (typeof comment.author === 'string') {\n  authorName = comment.author;\n} else if (comment.author?.name) {\n  authorName = comment.author.name;\n}\n\nreturn {\n  json: {\n    commentId: comment.id,\n    postUrn: postUrn,\n    commenterName: authorName,\n    originalComment: comment.text || '',\n    generatedResponse: userMessage,\n    timestamp: new Date().toISOString()\n  }\n};"
      }
    }
