    {
      "parameters": {
        "jsCode": "const allConnections = $input.first().json.all_connections || [];\n\nreturn allConnections.map((conn, index) => ({\n  json: {\n    linkedin_id: conn.member_id || '',\n    first_name: conn.first_name || '',\n    last_name: conn.last_name || '',\n    display_name: `${conn.first_name} ${conn.last_name}`,\n    profile_url: conn.public_profile_url || '',\n    headline: conn.headline || '',\n    profile_picture_url: conn.profile_picture_url || '',\n    connection_urn: conn.connection_urn || '',\n    message_sent: false,\n    scheduled_date: null\n  },\n  pairedItem: { item: 0 }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ],
      "id": "287f6723-2505-4749-a03a-a7f3c17a08d1",
      "name": "clean data format fo Gsheet1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst currentPageData = items[0].json;\n\n// Extract new connections from current response\nconst newConnections = currentPageData.items || [];\nconst cursor = currentPageData.cursor || null;\n\n// Get previous connections from the input (passed through loop)\nconst previousConnections = items[0].json.all_connections || [];\n\n// Merge with previous connections\nconst allConnections = [\n  ...previousConnections,\n  ...newConnections\n];\n\nreturn [{\n  json: {\n    account_id: items[0].json.account_id || \"DZFi1PeCTDmiB9H8O0aiPw\",\n    cursor: cursor,\n    all_connections: allConnections,\n    page: (items[0].json.page || 1) + 1,\n    fetched_this_page: newConnections.length,\n    total_fetched: allConnections.length,\n    has_more: cursor !== null && cursor !== ''\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        192
      ],
      "id": "d7fa3da7-0ebb-468e-9754-74759704afef",
      "name": "Set Format and Extract Cursor1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst lastItem = items[items.length - 1].json;\n\n// Get cursor from the original HTTP Request node\nconst httpResponse = $('Get Connections1').first().json;\nconst cursor = httpResponse.cursor || null;\n\n// Get account_id from either lastItem or HTTP response\nconst account_id = lastItem.account_id || httpResponse.account_id || \"DZFi1PeCTDmiB9H8O0aiPw\";\n\nreturn [{\n  json: {\n    account_id: account_id,\n    cursor: cursor,\n    page: 1,\n    saved_this_batch: items.length,\n    has_more: cursor !== null && cursor !== '' && cursor !== undefined\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        192
      ],
      "id": "57088973-b0f1-40db-ba9c-4bf7059bf989",
      "name": "clean data format fo Gsheet2"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst lastItem = items[items.length - 3].json;\nconst cursor = lastItem.cursor;\n\nreturn [{\n  json: {\n    account_id: lastItem.account_id,\n    cursor: cursor,\n    page: 1,\n    saved_this_batch: items.length,\n    has_more: cursor !== null && cursor !== '' && cursor !== undefined\n  }\n}];"
      },
