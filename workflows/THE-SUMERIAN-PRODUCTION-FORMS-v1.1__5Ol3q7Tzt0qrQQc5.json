        0
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json; let b = r.body; if (typeof b === 'string') { try { b = JSON.parse(b); } catch (e) {} }\nconst esc = (s) => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');\nconst head = b && typeof b === 'object' ? (b.result || '') + (b.error_status ? ' · ' + b.error_status : '') + (b.approval_status ? ' · ' + b.approval_status : '') : 'HTTP ' + r.statusCode;\nconst html = '<h2>' + esc(head) + '</h2><p>HTTP ' + esc(r.statusCode) + '</p><pre style=\"white-space:pre-wrap;text-align:left;font-size:12px\">' + esc(typeof b === 'string' ? b : JSON.stringify(b, null, 2)) + '</pre>';\nreturn [{ json: { html } }];"
      }
    },
