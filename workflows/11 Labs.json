      "id": "33da7d4e-e38e-4ced-85b2-b8212dce1317",
      "name": "Zoho Availability",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        144,
        -16
      ],
      "parameters": {
        "url": "https://www.zohoapis.com/bookings/v1/json/availableslots",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "zohoOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "json",
        "jsonQuery": "={\n  \"service_id\": \"{{your_service_id}}\",\n  \"staff_id\": \"{{your_staff_id}}\",\n  \"customer_details\": {\n    \"name\": \"{{$json.name}}\",\n    \"email\": \"{{$json.email}}\",\n    \"phone\": \"{{$json.phone}}\"\n  },\n  \"from_time\": \"{{$json.date}}T{{$json.time}}:00\",\n  \"timezone\": \"{{$json.timezone}}\"\n}",
        "options": {}
      },
      "credentials": {
        "zohoOAuth2Api": {
          "id": "eX2d7494WeuOIbhz",
          "name": "Zoho account"
        }
