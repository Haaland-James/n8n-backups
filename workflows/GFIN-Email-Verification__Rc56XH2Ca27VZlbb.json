      "parameters": {
        "jsCode": "// Tally what this run produced.\nlet rows = [];\ntry { rows = $('Map Verification Result').all().map(i => i.json); } catch (e) {}\n\nconst tally = {};\nfor (const r of rows) {\n  const k = r.sendability || 'unknown';\n  tally[k] = (tally[k] || 0) + 1;\n}\n\nreturn [{ json: {\n  run_id: $execution.id,\n  finished_at: new Date().toISOString(),\n  verified_this_run: rows.length,\n  by_sendability: tally\n}}];"
