      "id": "b04c5f67-b545-44ab-8e76-cdc0932eae60",
      "name": "MillionVerifier: Verify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1088,
        528
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpQueryAuth": {
          "id": "usnGPvG9S60pIXrJ",
          "name": "SerpApi Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Map MillionVerifier's response onto GFIN sendability states.\n// MV result values: ok | catch_all | unknown | disposable | invalid | error\n\nconst lead = $('Loop Over Emails').item.json;\nconst v = $json || {};\n\nconst result = String(v.result || 'unknown').toLowerCase();\nconst role = v.role === true || String(v.role).toLowerCase() === 'true';\nconst apiErrored = !!v.error || result === 'error';\n\nlet confidence;\nif (result === 'ok') confidence = 90;\nelse if (result === 'catch_all') confidence = 50;\nelse if (result === 'unknown') confidence = 30;\nelse confidence = 0; // invalid, disposable, error\n\n// Role accounts (info@, admin@, contact@) deliver fine but convert badly on cold outreach.\nif (role && confidence > 0) confidence -= 20;\n\nlet sendability;\nif (apiErrored) sendability = 'unknown';\nelse if (result === 'ok') sendability = role ? 'role_account' : 'sendable';\nelse if (result === 'catch_all') sendability = 'risky_catch_all';\nelse if (result === 'invalid' || result === 'disposable') sendability = 'do_not_send';\nelse sendability = 'unknown';\n\nreturn { json: {\n  provider_id: lead.provider_id,\n  email: lead.email,\n  email_check_result: apiErrored ? 'error' : result,\n  accept_all: result === 'catch_all',\n  email_is_role: role,\n  email_verified: result === 'ok',\n  email_confidence: confidence,\n  sendability: sendability,\n  email_verified_at: new Date().toISOString()\n}};"
      },
