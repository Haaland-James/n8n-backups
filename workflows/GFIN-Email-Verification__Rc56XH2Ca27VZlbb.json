    {
      "parameters": {
        "jsCode": "// Pick rows worth spending a verification credit on.\n// Skips: no email, already verified, already emailed, unsubscribed, no write-back key.\n\nconst MAX_PER_RUN = 200;\nconst ne = (v) => v !== undefined && v !== null && String(v).trim() !== '';\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!ne(r.email)) continue;\n  if (!ne(r.provider_id)) continue;\n  if (ne(r.email_check_result)) continue;\n  if (ne(r.email_sent_at)) continue;\n  if (String(r.email_send_status || '').toLowerCase() === 'unsubscribed') continue;\n  out.push({ json: r });\n}\n\nconsole.log(`Verification queue: ${out.length} candidates, sending ${Math.min(out.length, MAX_PER_RUN)}`);\nreturn out.slice(0, MAX_PER_RUN);"
      },
