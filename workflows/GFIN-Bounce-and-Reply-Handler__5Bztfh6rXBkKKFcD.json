    {
      "parameters": {
        "jsCode": "// Map each classified message onto its Lead Pool row by email address.\n\nconst pool = $input.all().map(i => i.json);\nlet msgs = [];\ntry {\n  msgs = $('Classify Message').all().map(i => i.json).filter(m => m.kind !== 'ignore' && m.target_email);\n} catch (e) {}\n\nconst byEmail = new Map();\nfor (const r of pool) {\n  const e = String(r.email || '').trim().toLowerCase();\n  if (e && r.provider_id && !byEmail.has(e)) byEmail.set(e, r);\n}\n\nconst out = [];\nfor (const m of msgs) {\n  const row = byEmail.get(String(m.target_email).toLowerCase());\n  if (!row) {\n    console.log(`No Lead Pool row for ${m.target_email} (${m.kind}) - skipped`);\n    continue;\n  }\n\n  const base = { provider_id: row.provider_id };\n\n  if (m.kind === 'hard_bounce') {\n    out.push({ json: { ...base, email_send_status: 'bounced', sendability: 'do_not_send', email_confidence: 0, bounced_at: m.received_at }});\n  } else if (m.kind === 'soft_bounce') {\n    out.push({ json: { ...base, email_send_status: 'soft_bounce', bounced_at: m.received_at }});\n  } else if (m.kind === 'human_reply') {\n    out.push({ json: { ...base, reply_text: `[${m.subject}] ${m.snippet}`.slice(0, 900), replied_at: m.received_at, status: 'Replied', last_action: 'email_reply' }});\n  }\n}\n\nconsole.log(`Bounce/reply handler: ${msgs.length} actionable, ${out.length} matched`);\nreturn out;"
      },
