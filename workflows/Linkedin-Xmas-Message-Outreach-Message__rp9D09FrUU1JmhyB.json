      "parameters": {
        "jsCode": "const firstName = $input.item.json.first_name || '';\nconst linkedinUserId = $input.item.json.linkedin_user_id;\n\n// Personalize message\nconst message = firstName \n  ? `Hi ${firstName}, from my family to yours, Happy Holidays! 🎄`\n  : `From my family to yours, Happy Holidays! 🎄`;\n\nreturn {\n  json: {\n    linkedin_user_id: linkedinUserId,\n    message: message,\n    first_name: firstName,\n    row_number: $input.item.json.row_number,\n    image_url: 'https://damuwinston.com/wp-content/uploads/2025/12/Happy_holidays_wishes.webp'\n  }\n};"
