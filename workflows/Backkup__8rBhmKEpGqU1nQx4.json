    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || $input.first().json.output || '';\n\nlet selected;\ntry {\n  const clean = raw.replace(/```json|```/g, '').trim();\n  selected = JSON.parse(clean);\n} catch (e) {\n  // Parse failed — use fallback\n  return [{\n    json: {\n      source_image_url: $input.first().json.fallbackImageUrl || '',\n      image_reason: 'AI parse failed — using fallback',\n      image_source: 'fallback'\n    }\n  }];\n}\n\nif (!selected?.url) {\n  return [{\n    json: {\n      source_image_url: $input.first().json.fallbackImageUrl || '',\n      image_reason: 'No URL in AI response — using fallback',\n      image_source: 'fallback'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    imageUrl: selected.url,\n    image_reason: selected.reason || '',\n    image_source: 'google_search'\n  }\n}];"
      },
