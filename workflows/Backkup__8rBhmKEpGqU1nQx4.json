        "jsCode": "const items = $input.all();\nconst best = items.reduce((top, item) => {\n  return item.json.ai_score > top.json.ai_score ? item : top;\n}, items[0]);\n\nreturn [{ json: {\n  ...best.json,\n  source_link: best.json.source_link || best.json.link || best.json.url || best.json.guid || ''\n}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        416
      ],
      "id": "ed3a4ea2-2d7b-4eb3-a4f6-3d94af0c7c79",
      "name": "select highest score"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  try {\n    let raw = item.json.output || '';\n    \n    // Strip backticks and json fencing\n    raw = raw.replace(/```json|```/g, '').trim();\n    \n    // Find JSON object\n    const match = raw.match(/\\{[\\s\\S]*\\}/);\n    if (!match) throw new Error(\"No JSON object found\");\n    \n    // Clean common AI mistakes in JSON values\n    const cleaned = match[0]\n      .replace(/:\\s*\"([^\"]*)\"([^,}\\]]*)/g, (m, p1, p2) => `: \"${p1.replace(/\\n/g, ' ')}\"${p2}`)\n      .replace(/,\\s*}/g, '}')\n      .replace(/,\\s*]/g, ']');\n    \n    const parsed = JSON.parse(cleaned);\n\n    return { json: {\n      ...item.json,\n      ai_score: Number(parsed.score) || 0,\n      ai_reason: parsed.reason || '',\n      ai_category: parsed.category || '',\n      ai_urgency: parsed.urgency || '',\n      ai_audience: parsed.audience || '',\n      source_link: parsed.link        // ← from AI output\n        || item.json.link             // ← from RSS input\n        || item.json.url \n        || item.json.guid \n        || ''\n    }};\n  } catch (e) {\n    return { json: {\n      ...item.json,\n      ai_score: 0,\n      ai_reason: \"Parse error: \" + e.message,\n      ai_category: \"unknown\",\n      ai_urgency: \"low\",\n      ai_audience: \"all\",\n      source_link: item.json.link || item.json.url || item.json.guid || ''\n    }};\n  }\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        416
      ],
      "id": "535be670-a8a4-4902-99ce-fc642ea9b887",
      "name": "Cleans and parses "
    },
    {
      "parameters": {
        "jsCode": "// On the error branch, n8n puts the original input under $input.first().json\n// but also check the error message context\nconst json = $input.first().json;\n\n// The RSS title may be nested in the original item that caused the error\nconst title = json.title \n  || json.headline\n  || json.name\n  || '';\n\nconst snippet = json.contentSnippet \n  || json.summary \n  || json.description\n  || json.content\n  || '';\n\n// Log what we actually have for debugging\nconsole.log('Available fields:', Object.keys(json));\nconsole.log('Title found:', title);\n\nconst fallbackImageUrl = 'https://withagi.space/og-image.png';\n\nconst cleanTitle = title\n  .replace(/[^a-zA-Z0-9 ]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .split(' ')\n  .slice(0, 8)\n  .join(' ');\n\nreturn [{\n  json: {\n    ...json,\n    title,\n    snippet,\n    fallbackImageUrl,\n    searchQuery: cleanTitle || 'artificial intelligence news'\n  }\n}];"
      },
      "id": "0135d3fe-3440-406f-b773-511da2199c93",
      "name": "Prepare Search Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
