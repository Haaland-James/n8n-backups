      "id": "a54a9167-57b8-48cb-bd0f-491fcf1b364d",
      "name": "SerpAPI Image Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        928
      ],
      "notes": "Replace YOUR_SERPAPI_KEY with your actual key from serpapi.com\ntbs=isz:l filters for large images only"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.images_results || [];\nconst title = $input.first().json.searchQuery || '';\nconst snippet = $input.first().json.snippet || '';\nconst fallbackImageUrl = $input.first().json.fallbackImageUrl || '';\n\nif (!results.length) {\n  // No results — pass fallback through\n  return [{\n    json: {\n      title,\n      snippet,\n      fallbackImageUrl,\n      imageOptions: [],\n      hasFallback: true\n    }\n  }];\n}\n\n// Take top 10 and extract key fields for AI scoring\nconst imageOptions = results.slice(0, 10).map((img, i) => ({\n  index: i,\n  url: img.original || img.thumbnail || '',\n  title: img.title || '',\n  source: img.source || '',\n  width: img.original_width || 0,\n  height: img.original_height || 0,\n  isLandscape: (img.original_width || 0) > (img.original_height || 0)\n})).filter(img => img.url);\n\nreturn [{\n  json: {\n    title,\n    snippet,\n    fallbackImageUrl,\n    imageOptions,\n    hasFallback: false\n  }\n}];"
      },
      "id": "ea8ef7d8-0633-4d49-9ff4-15a9123d9632",
