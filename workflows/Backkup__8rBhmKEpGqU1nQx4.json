    {
      "parameters": {
        "promptType": "define",
        "text": "=Score this article for relevance to WithAGI's LinkedIn audience (AI professionals, founders, enterprise teams, and developers building with or evaluating autonomous AI agents).\n\nScoring criteria:\n+3 if it directly relates to AI agents, agentic AI, LLM orchestration, or autonomous AI systems\n+3 if it affects enterprise AI adoption, AI infrastructure, or AI security/compliance\n+2 if it is timely or actionable (new model release, policy shift, major product launch)\n+2 if a founder, CTO, or AI product strategist would find it valuable\n\nArticle Title: {{ $json.title }}\nArticle Summary: {{ $json.contentSnippet }}\nSource: {{ $json.link }}\nPublished: {{ $json.pubDate }}\n\nReturn ONLY this JSON structure with no other text:\n{\n  \"link\": {{ $json.link }},\n  \"title\": {{ $json.title }},\n  \"content\": {{ $json.content }},\n  \"isoDate\": {{ $json.isoDate }},\n  \"author\": \"the author of the article\",\n  \"score\": 0,\n  \"reason\": \"one sentence explaining the score\",\n  \"category\": \"ai-agents | llms | enterprise-ai | ai-security | ai-policy | ai-tools | other\",\n  \"urgency\": \"high | medium | low\",\n  \"audience\": \"founders | developers | enterprise-teams | ai-researchers | all\"\n}",
        "options": {
          "systemMessage": "You are a senior AI intelligence analyst for WithAGI — an autonomous AI agent platform built for professionals who need real outcomes, not just conversations. You have deep expertise in large language models, agentic AI systems, AI infrastructure, enterprise automation, and the evolving AI regulatory and investment landscape.\n\nYour job is to evaluate news articles for relevance to WithAGI's LinkedIn audience and return structured JSON only. No explanations, no markdown, no extra text — just raw JSON."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        -80,
        416
      ],
      "id": "67ec4cd5-a4f4-403e-8211-627b47de170e",
      "name": "AI Agent: Score Articles"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a LinkedIn post for WithAGI about this article.\n\nStructure:\n- Hook: 1 punchy opening line (do NOT start with an emoji)\n- 2-3 lines of expert insight from WithAGI's perspective on what this means for autonomous AI, agentic workflows, or enterprise AI adoption\n- 1 line on what this means for professionals building or evaluating AI agent systems\n- Soft CTA (follow our page, visit withagi.space, or drop a comment)\n- 3-5 relevant hashtags on the last line\n\nMax 200 words. No fluff. No em dashes.\n\nArticle: {{ $json.output }}\nCategory: {{ $json.ai_category }}\nUrgency: {{ $json.ai_urgency }}\nAudience: {{ $json.ai_audience }}",
        "options": {
          "systemMessage": "You are a LinkedIn content writer for WithAGI — an autonomous AI agent platform that delivers real work outcomes for professionals, not just conversations.\n\nYour writing style:\n- Direct and confident, like a practitioner who lives at the intersection of AI research and real-world deployment\n- No corporate filler: never use \"in today's landscape\", \"it's more important than ever\", \"game-changer\", or \"unlock\"\n- Short sentences. Active voice.\n- You write for an audience of founders, CTOs, AI engineers, and enterprise teams evaluating or building with autonomous AI agents\n- Always sound like a human expert sharing insider knowledge, not a press release\n\nReturn only the post text. No labels, no subject lines, no commentary."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        544,
        416
      ],
      "id": "fed9f2df-12d4-47ad-80a9-9516cf569d3b",
      "name": "post creator"
    },
    {
      "parameters": {
        "url": "={{ $('select highest score').item.json.source_link }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -80,
        704
      ],
      "id": "728e41df-71fb-4582-a971-1753ca7c0326",
      "name": "Fetch Article",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  const html = item.json.html || item.json.data;\n  let imageUrl = '';\n  \n  if (html) {\n    // Try multiple methods to find the best image\n    \n    // Method 1: Open Graph image (most reliable for articles)\n    let match = html.match(/<meta[^>]*property=[\"']og:image[\"'][^>]*content=[\"']([^\"']+)[\"'][^>]*>/i);\n    if (match) {\n      imageUrl = match[1];\n    }\n    \n    // Method 2: Twitter card image\n    if (!imageUrl) {\n      match = html.match(/<meta[^>]*name=[\"']twitter:image[\"'][^>]*content=[\"']([^\"']+)[\"'][^>]*>/i);\n      if (match) {\n        imageUrl = match[1];\n      }\n    }\n    \n    // Method 3: Featured/hero images (common in blog posts)\n    if (!imageUrl) {\n      const featuredSelectors = [\n        /<img[^>]*class=[\"'][^\"']*featured[^\"']*[\"'][^>]*src=[\"']([^\"']+)[\"'][^>]*>/i,\n        /<img[^>]*class=[\"'][^\"']*hero[^\"']*[\"'][^>]*src=[\"']([^\"']+)[\"'][^>]*>/i,\n        /<img[^>]*class=[\"'][^\"']*post-image[^\"']*[\"'][^>]*src=[\"']([^\"']+)[\"'][^>]*>/i,\n        /<img[^>]*class=[\"'][^\"']*wp-post-image[^\"']*[\"'][^>]*src=[\"']([^\"']+)[\"'][^>]*>/i\n      ];\n      \n      for (const regex of featuredSelectors) {\n        match = html.match(regex);\n        if (match) {\n          imageUrl = match[1];\n          break;\n        }\n      }\n    }\n    \n    // Method 4: First image in article content\n    if (!imageUrl) {\n      match = html.match(/<(?:article|div[^>]*class=[\"'][^\"']*(?:content|post|article)[^\"']*[\"'])[^>]*>.*?<img[^>]*src=[\"']([^\"']+)[\"'][^>]*>/is);\n      if (match) {\n        imageUrl = match[1];\n      }\n    }\n    \n    // Method 5: Any reasonably sized image (width > 300px)\n    if (!imageUrl) {\n      const imgMatches = html.match(/<img[^>]*src=[\"']([^\"']+)[\"'][^>]*>/gi);\n      if (imgMatches) {\n        for (const imgTag of imgMatches) {\n          const srcMatch = imgTag.match(/src=[\"']([^\"']+)[\"']/);\n          const widthMatch = imgTag.match(/width=[\"']?(\\d+)/);\n          \n          if (srcMatch && (!widthMatch || parseInt(widthMatch[1]) > 300)) {\n            imageUrl = srcMatch[1];\n            break;\n          }\n        }\n      }\n    }\n    \n    // Clean up relative URLs\n    if (imageUrl && imageUrl.startsWith('//')) {\n      imageUrl = 'https:' + imageUrl;\n    } else if (imageUrl && imageUrl.startsWith('/')) {\n      const linkUrl = item.json.link || '';\n      const baseUrl = linkUrl.match(/^https?:\\/\\/[^\\/]+/);\n      if (baseUrl) {\n        imageUrl = baseUrl[0] + imageUrl;\n      }\n    }\n    \n    // Validate it's actually an image\n    if (imageUrl && !imageUrl.match(/\\.(jpg|jpeg|png|gif|webp|svg)(\\?.*)?$/i)) {\n      // Check if it might be a valid image URL without extension\n      if (!imageUrl.includes('image') && !imageUrl.includes('photo') && !imageUrl.includes('pic')) {\n        imageUrl = '';\n      }\n    }\n  }\n  \n  // Add image data to your item\n  item.json.imageUrl = imageUrl;\n  item.json.hasImage = !!imageUrl;\n  \n  // Log for debugging\n  if (imageUrl) {\n    console.log(`Found image: ${imageUrl}`);\n  } else {\n    console.log('No image found for article');\n  }\n}\n\nreturn items;"
      },
