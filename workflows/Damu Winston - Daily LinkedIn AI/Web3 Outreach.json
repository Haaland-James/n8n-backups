          "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const firstName = item.json.first_name || item.json.display_name || 'there';\n  const message = 'Hey ' + firstName + ',\\n\\nI know you\\'re in the Web3/Tokenization space, but what are you doing in the AI space?\\n\\nLet\\'s reconnect - I\\'d love to hear what you\\'re up to.\\n\\nVisit www.DamuWinston.com and try \"Ask my voice AI\" to coordinate a time for us to connect.\\n\\nLooking forward to it!';\n\n  results.push({\n    json: {\n      ...item.json,\n      message: message,\n      sent_at: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
        }
