      "parameters": {
        "jsCode": "const keywords = [\n  'web3', 'web 3', 'artificial intelligence',\n  'blockchain', 'tokenization', 'tokenisation'\n];\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const headline = (item.json.headline || '').toLowerCase();\n  const matched = keywords.some(kw => headline.includes(kw));\n  if (matched) {\n    results.push({\n      json: {\n        linkedin_id: String(item.json.linkedin_id || ''),\n        first_name: item.json.first_name || '',\n        last_name: item.json.last_name || '',\n        display_name: item.json.display_name || '',\n        profile_url: item.json.profile_url || '',\n        headline: item.json.headline || ''\n      }\n    });\n  }\n}\n\nreturn results;"
      },
