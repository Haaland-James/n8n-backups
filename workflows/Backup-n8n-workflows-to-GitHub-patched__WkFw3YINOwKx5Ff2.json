      "id": "303c556c-2905-4fb4-9295-c2df91e0b75c",
      "name": "Get All Workflows",
      "type": "n8n-nodes-base.n8n",
      "position": [
        960,
        1488
      ],
      "executeOnce": false,
      "retryOnFail": true,
      "typeVersion": 1,
      "alwaysOutputData": true,
