        "n8nApi": {
          "id": "dQGMVsrqkI1VqTKU",
          "name": "n8n account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// =======================\n// READ INPUTS\n// =======================\n\n// Current workflows from n8n\nconst workflows = $input.all()\n  .map(i => i.json)\n  .filter(w => w && typeof w.id === 'string' && typeof w.name === 'string');\n\n// Index file (workflow id -> { name, file_path })\nconst rawIndex = $('Get Index File Content').first()?.json ?? {};\nlet indexData = {};\nif (typeof rawIndex.data === 'string') {\n  try { indexData = JSON.parse(rawIndex.data || '{}'); } catch (e) { indexData = {}; }\n} else if (rawIndex.data && typeof rawIndex.data === 'object') {\n  indexData = rawIndex.data;\n} else if (!('data' in rawIndex)) {\n  indexData = rawIndex;\n}\n\n// Every file that really exists in the repo right now (path -> true)\nconst tree = $('List Repo Files').first()?.json ?? {};\nif (!Array.isArray(tree.tree)) {\n  throw new Error('Could not list repo files: ' + JSON.stringify(tree).slice(0, 300));\n}\nif (tree.truncated) {\n  throw new Error('GitHub returned a truncated file listing - repo too large for this check.');\n}\nconst repoPaths = new Set(tree.tree.filter(t => t.type === 'blob').map(t => t.path));\n\n// Safety net: never wipe backups because n8n returned nothing\nif (workflows.length === 0 && Object.keys(indexData).length > 0) {\n  throw new Error('n8n returned 0 workflows but the index has entries - aborting to protect backups.');\n}\n\n// =======================\n// HELPERS\n// =======================\n\n// Safe, collision-proof path: readable name + workflow id\nconst slug = (s) =>\n  String(s || 'unnamed')\n    .replace(/[^\\p{L}\\p{N}._-]+/gu, '-')\n    .replace(/-+/g, '-')\n    .replace(/^[-.]+|[-.]+$/g, '')\n    .slice(0, 80) || 'unnamed';\nconst pathFor = (w) => `workflows/${slug(w.name)}__${w.id}.json`;\nconst sortObj = (o) => Object.fromEntries(Object.keys(o).sort().map(k => [k, o[k]]));\n\n// =======================\n// CREATE / EDIT / RENAME\n// =======================\n\nconst results = [];\nconst updatedIndex = {};\nconst seen = new Set();\n\nfor (const wf of workflows) {\n  const id = wf.id;\n  const name = wf.name || 'unnamed';\n  const path = pathFor(wf);\n  const prev = indexData[id];\n  seen.add(id);\n\n  // Path changed (rename, or migration from old naming): remove the old file if it exists\n  if (prev && prev.file_path && prev.file_path !== path && repoPaths.has(prev.file_path)) {\n    results.push({ status: 'delete', workflowId: id, name: prev.name, path: prev.file_path });\n  }\n\n  // File already in the repo -> edit (the edit checker commits only real changes).\n  // File missing -> create. This is what stops the \"sha wasn't supplied\" error.\n  results.push({\n    status: repoPaths.has(path) ? 'edit' : 'create',\n    workflowId: id,\n    name,\n    path,\n    data: wf\n  });\n\n  updatedIndex[id] = { name, file_path: path };\n}\n\n// =======================\n// DELETE REMOVED WORKFLOWS\n// =======================\n\nfor (const [id, prev] of Object.entries(indexData)) {\n  if (seen.has(id)) continue;\n  if (prev && prev.file_path && repoPaths.has(prev.file_path)) {\n    results.push({ status: 'delete', workflowId: id, name: prev.name, path: prev.file_path });\n  }\n}\n\n// =======================\n// INDEX UPDATE (ONLY IF CHANGED)\n// =======================\n\nconst before = JSON.stringify(sortObj(indexData));\nconst sortedIndex = sortObj(updatedIndex);\nif (before !== JSON.stringify(sortedIndex)) {\n  results.push({ status: 'index', data: sortedIndex });\n}\n\nreturn results.map(r => ({ json: r }));"
      },
